body{font-family:'Poppins',Arial;
     max-width:700px;
      margin:20px auto;
      padding:15px;
       background:white}
header{text-align:center;
     background:white;
      padding:15px;
       border-radius:10px
    }
nav{display:flex;
     justify-content:center;
      gap:10px;
       flex-wrap:wrap
    }
nav a button{padding:8px 15px;
     border:none;
      background:teal;
       color:white;
        border-radius:5px;
         cursor:pointer
        }
#box{display:flex;
     justify-content:space-between;
      background:white;
       padding:15px;
        border-radius:10px;
         gap:10px
        }
main section{background:white;
     padding:15px;
      border-radius:10px;
       margin-top:15px
    }
form{display:flex; flex-wrap:wrap; gap:10px}
form input, form select, form button{padding:8px; flex:1 1 120px}
li{display:flex; justify-content:space-between; background:#fff; margin:10px 0; padding:10px; border-radius:5px}
footer{text-align:center; margin-top:20px; padding:10px; border-top:1px solid #ccc}
#errorMsg{color:red; font-weight:bold}

@media(max-width:600px){
  body{max-width:95%; margin:5px auto}
  #box{flex-direction:column}
  nav{flex-direction:column}
}